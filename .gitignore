# Hallmark design-skill scaffolding (provenance / diversification ledger).
# design.md (the locked system) IS tracked; this local log is not.
.hallmark/

# Marketing site lives in its own private repo (BodhiOrchard-Website), not here.
/landing-site/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
*.egg
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.pyc

# Virtual environments
.venv/
venv/
env/

# Environment files
.env
*.env.local
.env.production

# Node / Frontend
node_modules/
frontend/dist/
frontend/dist-landing/
# vite-ssg leaves a temp dir at the build root and another inside the configured
# entry root (frontend/landing-src/) — match both with a recursive glob.
**/.vite-ssg-temp/

# Legacy hand-coded landing page — deploy now comes from frontend/landing-src/
# Anchor to repo root so it doesn't also swallow `frontend/public/landing/`
# (in-app dev assets) or `frontend/landing-src/public/landing/` (landing-only).
/landing/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Docker
*.log

# Backend log capture (rotating handler in app/core/logging.py writes here;
# also covers any one-off `tee` output like logs.txt that may contain JWTs).
backend/logs/
logs.txt

# Database
*.sqlite3
*.db
.gitnexus
# Local Postgres dumps written by scripts/db/db_snapshot.sh.
# May contain real customer data; never check in.
.db-snapshots/

# Colyseus dev mode state (may contain JWTs)
.devmode.json

# reposcanv2 sandbox runs (JSON-on-disk persistence)
backend/reposcanv2_runs/

# Hybrid-host data dir (cloned repos + SSH deploy keypair). Default location
# when BODHIORCHARD_DATA_DIR is unset and /data isn't writable. Lives at the
# repo root (not under ``backend/``) so writes don't sit inside uvicorn's CWD
# and trigger reload-watcher cascades during scans. Non-dot name so graphify's
# collect_files walker doesn't drop every indexed file.
repoclone/

# Graphify analyzer output dropped under example repos during scans —
# build artifact, not source.
examples/*/graphify-out/

# Local DB ops scripts (snapshot / restore / switch). Operationally
# useful but contain assumptions about the developer's environment
# (asyncpg URL parsing, snapshot dir conventions) that don't belong
# in the parent repo's tracked set.
scripts/db/

# Example repos — tracked independently at github.com/mickyarun/taskflow-*.
# Run `bash examples/setup-git-history.sh` after cloning to bootstrap.
# Keeping them out of the parent repo's tracked set means FT-testing PR
# merges don't appear as bodhiorchard-side changes in `git status`.
examples/taskflow-api/
examples/taskflow-web/
examples/taskflow-worker/
examples/taskflow-qa/
# Java/Spring sample — hosted at github.com/mickyarun/taskflow-java-bodhiorchard-demo,
# cloned into examples/taskflow-spring/ by setup-git-history.sh.
examples/taskflow-spring/
# The example BUD spec ships with the example repos, not bodhiorchard core.
examples/BUD-001-tech-spec.md

# Plan and experiment artefacts. These tend to accumulate snapshots of
# real-world tuning data (customer repo names, dataset measurements) that
# don't belong in source control. Keep them local-only.
# Pattern: exclude everything directly under docs/ but re-include the
# README screenshots and the reference docs that ship with the repo.
docs/*
!docs/images/
!docs/ai-engines.md
!docs/api.md
!docs/deployment.md
backend/experiments/
