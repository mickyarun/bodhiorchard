{
  "name": "bodhiorchard-frontend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:landing": "vite-ssg build --config vite.landing.config.ts",
    "typecheck:landing": "vue-tsc --noEmit -p tsconfig.landing.json",
    "preview": "vite preview",
    "preview:landing": "vite preview --config vite.landing.config.ts --outDir dist-landing",
    "lint": "eslint . --ext .vue,.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "test -d ../.git && npx --yes npm-merge-driver install --driver-name=npm-merge-driver || true"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.42",
    "@dimforge/rapier3d": "^0.19.3",
    "@mdi/font": "^7.4.0",
    "@panzoom/panzoom": "^4.6.2",
    "@types/diff": "^7.0.2",
    "axios": "^1.16.0",
    "diff": "^7.0.0",
    "dompurify": "^3.4.2",
    "marked": "^17.0.5",
    "mermaid": "^11.15.0",
    "pinia": "^2.1.7",
    "playcanvas": "^2.18.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vue": "^3.5.34",
    "vue-router": "^4.3.0",
    "vuedraggable": "^4.1.0",
    "vuetify": "^3.5.0",
    "yuka": "^0.7.8"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/yuka": "^0.7.4",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^25.0.1",
    "sass": "^1.99.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vite-plugin-vuetify": "^2.0.0",
    "vite-ssg": "^0.23.8",
    "vitest": "^1.6.1",
    "vue-tsc": "^2.0.0"
  }
}
