# Production environment — copy to .env.production and fill in every value.
# .env.production is gitignored and must never be committed.

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=bodhiorchard
POSTGRES_PASSWORD=CHANGE_ME        # generate: openssl rand -hex 20
POSTGRES_DB=bodhiorchard

# ── Auth secrets ──────────────────────────────────────────────────────────────
# Generate SECRET_KEY:     python3 -c "import secrets; print(secrets.token_hex(32))"
# Generate ENCRYPTION_KEY: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=GENERATE_ME
ENCRYPTION_KEY=GENERATE_ME
# Rotating ENCRYPTION_KEY: set the new key above and the old one here, deploy,
# run (from backend/) python -m scripts.rotate_encryption_key --rotate, then
# remove this line once it reports nothing left.
# ENCRYPTION_KEY_PREVIOUS=

# ── HR encryption (employees' IDs, bank details, documents) ───────────────────
# Separate from ENCRYPTION_KEY. Required: the backend refuses to start without it.
# Generate (from backend/): python -m scripts.rotate_hr_keys --generate
# Keep old entries after the new one when rotating: "knew:...,kold:..."
HR_ENCRYPTION_KEYS=GENERATE_ME

# ── Colyseus bridge ───────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
COLYSEUS_BRIDGE_SECRET=GENERATE_ME

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── LLM models ────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_PREMIUM_MODEL=claude-sonnet-4-6

# ── Public URLs (must match DOMAIN above) ────────────────────────────────────
PUBLIC_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ── Integrations (optional) ───────────────────────────────────────────────────
GITHUB_PAT=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
